# Скопируйте этот файл в .env и заполните реальными значениями:
#   cp .env.example .env

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
DB_NAME=app_db
DB_USER=app_user
DB_PASSWORD=change-me-strong-password
DB_HOST=db
DB_PORT=5432
